{
  "name": "orion",
  "version": "1.0.9",
  "license": "GPL-3.0-only",
  "description": "Presentation software for church services",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:smoke": "npm run typecheck && vitest run",
    "test:e2e": "electron-vite build && electron ./out/main/index.js --e2e-verify",
    "dist:win": "electron-vite build && electron-builder --win --config electron-builder.config.cjs",
    "dist:linux": "electron-vite build && node scripts/ensure-linux-canvas.cjs && electron-builder --linux AppImage --config electron-builder.config.cjs",
    "dist:mac": "electron-vite build && node scripts/ensure-mac-canvas.cjs && electron-builder --mac dmg --universal --publish never --config electron-builder.config.cjs",
    "pack:library": "node scripts/pack-content-bundle.mjs",
    "bundle:kjv": "npx tsx scripts/bundle-kjv.ts",
    "bundle:adventist-hymnals": "npx tsx scripts/bundle-adventist-hymnals.ts"
  },
  "dependencies": {
    "@fontsource/cantarell": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@iconify-icons/coolicons": "^2.0.2",
    "@iconify/react": "^6.0.4",
    "@napi-rs/canvas": "^1.1.0",
    "@pagus-kit/core": "^0.1.1",
    "@pagus-kit/renderer": "^0.1.1",
    "7zip-bin": "^5.2.0",
    "fast-xml-parser": "^5.2.5",
    "iwork-viewer": "^0.0.2",
    "jszip": "^3.10.1",
    "mdb-reader": "^3.2.0",
    "mtx-decompressor": "^1.8.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "optionalDependencies": {
    "@napi-rs/canvas-linux-x64-gnu": "1.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.2",
    "vitest": "^3.2.4"
  }
}
