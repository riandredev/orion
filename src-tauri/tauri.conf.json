{
    "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "orion-tauri",
    "version": "0.1.0",
    "identifier": "com.tauri.dev",
    "build": {
        "frontendDist": "../out",
        "devUrl": "http://localhost:3000",
        "beforeDevCommand": "yarn dev",
        "beforeBuildCommand": "yarn build"
    },
    "bundle": {
        "active": true,
        "resources": [
            "resources/**/*",
            "migrations/**/*",
            "resources/db/*"
        ]
    },
    "app": {
        "security": {
            "csp": null,
            "assetProtocol": {
                "enable": true,
                "scope": ["**"]
            },
            "capabilities": [
                {
                    "identifier": "main-capability",
                    "description": "Capability for the main window",
                    "windows": ["main"],
                    "permissions": [
                        "core:default",
                        "dialog:default",
                        "fs:default",
                        "core:path:default",
                        "core:image:default",
                        "core:window:default",
                        "core:webview:default",
                        "core:event:default",
                        "core:resources:default",
                        "core:webview:allow-create-webview-window",
                        "core:window:allow-set-fullscreen",
                        "core:window:allow-create",
                        "core:window:allow-show",
                        "core:window:allow-destroy",
                        "core:window:allow-close",
                        "core:window:allow-set-position",
                        "core:window:allow-set-title",
                        "core:window:allow-set-size",
                        "core:window:allow-maximize",
                        {
                            "identifier": "fs:allow-read-file",
                            "allow": ["$RESOURCE/**/*"]
                        }
                    ]
                },
                {
                    "identifier": "image-window-0-capability",
                    "description": "Capability for the image window",
                    "windows": ["image-window-0"],
                    "permissions": [
                      "core:default",
                      "core:window:default",
                      "core:event:default",
                      "core:webview:default",
                      "core:window:allow-set-fullscreen",
                      "core:window:allow-set-position",
                      "core:window:allow-close",
                      "core:window:allow-set-title",
                      "core:window:allow-set-size",
                      "core:window:allow-maximize",
                      "core:window:allow-set-focus",
                      {
                        "identifier": "core:event:allow-listen",
                        "allow": ["change-image", "stopTimer"]
                      }
                    ]
                },
                {
                    "identifier": "image-window-1-capability",
                    "description": "Capability for the image window",
                    "windows": ["image-window-1"],
                    "permissions": [
                      "core:default",
                      "core:window:default",
                      "core:event:default",
                      "core:webview:default",
                      "core:window:allow-set-fullscreen",
                      "core:window:allow-set-position",
                      "core:window:allow-close",
                      "core:window:allow-set-title",
                      "core:window:allow-set-size",
                      "core:window:allow-maximize",
                      "core:window:allow-set-focus",
                      {
                        "identifier": "core:event:allow-listen",
                        "allow": ["change-image", "stopTimer"]
                      }
                    ]
                },
                {
                    "identifier": "image-window-2-capability",
                    "description": "Capability for the image window",
                    "windows": ["image-window-2"],
                    "permissions": [
                      "core:default",
                      "core:window:default",
                      "core:event:default",
                      "core:webview:default",
                      "core:window:allow-set-fullscreen",
                      "core:window:allow-set-position",
                      "core:window:allow-close",
                      "core:window:allow-set-title",
                      "core:window:allow-set-size",
                      "core:window:allow-maximize",
                      "core:window:allow-set-focus",
                      {
                        "identifier": "core:event:allow-listen",
                        "allow": ["change-image", "stopTimer"]
                      }
                    ]
                },
                {
                    "identifier": "image-window-3-capability",
                    "description": "Capability for the image window",
                    "windows": ["image-window-3"],
                    "permissions": [
                      "core:default",
                      "core:window:default",
                      "core:event:default",
                      "core:webview:default",
                      "core:window:allow-set-fullscreen",
                      "core:window:allow-set-position",
                      "core:window:allow-close",
                      "core:window:allow-set-title",
                      "core:window:allow-set-size",
                      "core:window:allow-maximize",
                      "core:window:allow-set-focus",
                      {
                        "identifier": "core:event:allow-listen",
                        "allow": ["change-image", "stopTimer"]
                      }
                    ]
                },
                {
                    "identifier": "image-window-4-capability",
                    "description": "Capability for the image window",
                    "windows": ["image-window-4"],
                    "permissions": [
                      "core:default",
                      "core:window:default",
                      "core:event:default",
                      "core:webview:default",
                      "core:window:allow-set-fullscreen",
                      "core:window:allow-set-position",
                      "core:window:allow-close",
                      "core:window:allow-set-title",
                      "core:window:allow-set-size",
                      "core:window:allow-maximize",
                      "core:window:allow-set-focus",
                      {
                        "identifier": "core:event:allow-listen",
                        "allow": ["change-image", "stopTimer"]
                      }
                    ]
                },
                {
                    "identifier": "clock-window-0-capability",
                    "description": "Capability for the clock window",
                    "windows": ["clock-window-0"],
                    "permissions": [
                      "core:default",
                      "core:window:default",
                      "core:event:default",
                      "core:webview:default",
                      "core:window:allow-set-fullscreen",
                      "core:window:allow-set-position",
                      "core:window:allow-close",
                      "core:window:allow-set-title",
                      "core:window:allow-set-size",
                      "core:window:allow-maximize",
                      {
                        "identifier": "core:event:allow-listen",
                        "allow": ["stopTimer"]
                      }
                    ]
                },
                {
                    "identifier": "clock-window-1-capability",
                    "description": "Capability for the clock window",
                    "windows": ["clock-window-1"],
                    "permissions": [
                      "core:default",
                      "core:window:default",
                      "core:event:default",
                      "core:webview:default",
                      "core:window:allow-set-fullscreen",
                      "core:window:allow-set-position",
                      "core:window:allow-close",
                      "core:window:allow-set-title",
                      "core:window:allow-set-size",
                      "core:window:allow-maximize",
                      {
                        "identifier": "core:event:allow-listen",
                        "allow": ["stopTimer"]
                      }
                    ]
                },
                {
                    "identifier": "hymn-window-0-capability",
                    "description": "Capability for the hymn window",
                    "windows": ["hymn-window-0"],
                    "permissions": [
                      "core:default",
                      "core:window:default",
                      "core:event:default",
                      "core:webview:default",
                      "core:window:allow-set-fullscreen",
                      "core:window:allow-set-position",
                      "core:window:allow-close",
                      "core:window:allow-set-title",
                      "core:window:allow-set-size",
                      "core:window:allow-maximize",
                      "core:window:allow-outer-position",
                      "core:window:allow-outer-size",
                      "core:window:allow-set-focus",
                      {
                        "identifier": "core:event:allow-listen",
                        "allow": ["hymn-navigation", "stopTimer", "verse-state-changed", "capture-screenshot"]
                      }
                    ]
                },
                {
                    "identifier": "hymn-window-1-capability",
                    "description": "Capability for the clock window",
                    "windows": ["hymn-window-1"],
                    "permissions": [
                      "core:default",
                      "core:window:default",
                      "core:event:default",
                      "core:webview:default",
                      "core:window:allow-set-fullscreen",
                      "core:window:allow-set-position",
                      "core:window:allow-close",
                      "core:window:allow-set-title",
                      "core:window:allow-set-size",
                      "core:window:allow-maximize",
                      "core:window:allow-set-focus",
                      {
                        "identifier": "core:event:allow-listen",
                        "allow": ["hymn-navigation", "stopTimer", "verse-state-changed"]
                      }
                    ]
                },
                {
                    "identifier": "hymn-window-2-capability",
                    "description": "Capability for the clock window",
                    "windows": ["hymn-window-2"],
                    "permissions": [
                      "core:default",
                      "core:window:default",
                      "core:event:default",
                      "core:webview:default",
                      "core:window:allow-set-fullscreen",
                      "core:window:allow-set-position",
                      "core:window:allow-close",
                      "core:window:allow-set-title",
                      "core:window:allow-set-size",
                      "core:window:allow-maximize",
                      "core:window:allow-set-focus",
                      {
                        "identifier": "core:event:allow-listen",
                        "allow": ["hymn-navigation", "stopTimer", "verse-state-changed"]
                      }
                    ]
                },
                {
                    "identifier": "bible-window-0-capability",
                    "description": "Capability for the bible verse window",
                    "windows": ["bible-window-0"],
                    "permissions": [
                      "core:default",
                      "core:window:default",
                      "core:event:default",
                      "core:webview:default",
                      "core:window:allow-set-fullscreen",
                      "core:window:allow-set-position",
                      "core:window:allow-close",
                      "core:window:allow-set-title",
                      "core:window:allow-set-size",
                      "core:window:allow-maximize",
                      "core:window:allow-outer-position",
                      "core:window:allow-outer-size",
                      "core:window:allow-set-focus",
                      {
                        "identifier": "core:event:allow-listen",
                        "allow": ["verse-navigation", "stopTimer", "capture-screenshot", "update-verse", "start_stream", "stop_stream"]
                      }
                    ]
                }
            ]
        },
        "windows": [
            {
                "title": "Orion",
                "label": "main",
                "width": 1280,
                "height": 720,
                "minWidth": 1280,
                "minHeight": 720,
                "resizable": true,
                "fullscreen": false,
                "maximized": false,
                "transparent": false,
                "theme": "Dark",
                "center": true,
                "visible": true
            }
        ]
    },
    "plugins": {
        "sql": {
            "enabled": true,
            "preload": ["sqlite:hymnals.db"],
            "copyFile": true,
            "migrationDir": "migrations"
        }
    }
}
